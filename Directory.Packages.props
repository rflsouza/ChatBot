<Project>
  <!-- Central Package Management: todas as versões ficam aqui. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Versão da release dotnet-1.25.0 do Microsoft Agent Framework (14/10/2026). -->
    <AgentFrameworkVersion>1.25.0</AgentFrameworkVersion>
    <AgentFrameworkPreviewVersion>1.25.0-preview.261014.1</AgentFrameworkPreviewVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft Agent Framework (sucessor de Semantic Kernel + AutoGen) -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="$(AgentFrameworkVersion)" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting" Version="$(AgentFrameworkPreviewVersion)" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" Version="$(AgentFrameworkPreviewVersion)" />

    <!-- Microsoft.Extensions.AI (IChatClient) + provedor OpenAI-compatível -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />

    <!-- AG-UI .NET SDK oficial (cliente) -->
    <PackageVersion Include="AGUI.Client" Version="1.0.0" />

    <!-- Autenticação Entra ID (Azure OpenAI / Microsoft Foundry) -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />

    <!-- ASP.NET Core -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />

    <!-- Persistência: EF Core 10 + SQLite (histórico/memória dos agentes) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
  </ItemGroup>
</Project>
