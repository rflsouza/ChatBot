@page "/"
@using System.Text.RegularExpressions
@using AGUI.Abstractions
@inject ChatBotApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>ChatBot</PageTitle>

<header class="chat-header">
    <div class="page-width header-content">
        <h1>💬 ChatBot</h1>

        <div class="header-actions">
            @if (agents.Count > 0)
            {
                <select value="@selectedAgentId" @onchange="OnAgentChanged" disabled="@IsBusy" title="Modelo / agente">
                    @foreach (var agent in agents)
                    {
                        <option value="@agent.Id">@agent.DisplayName (@agent.Model)</option>
                    }
                </select>
            }
            <button class="secondary" @onclick="NewConversation" disabled="@IsBusy">Nova conversa</button>
        </div>
    </div>
</header>

<main class="message-list" @ref="messageListElement">
    <div class="page-width">
        @if (loadingHistory)
        {
            <div class="empty-state"><p>Carregando conversa…</p></div>
        }
        else if (messages.Count == 0 && inProgress is null)
        {
            <div class="empty-state">
                <h2>Como posso ajudar?</h2>
                @if (SelectedAgent?.Description is { } description)
                {
                    <p>@description</p>
                }
            </div>
        }

        @foreach (var message in messages)
        {
            <ChatMessageItem @key="message" Message="message" />
        }

        @if (inProgress is not null)
        {
            <ChatMessageItem Message="inProgress" InProgress="true" ToolCalls="toolCalls" />
        }

        @if (error is not null)
        {
            <div class="error-message">⚠️ @error</div>
        }
    </div>
</main>

<footer class="chat-footer">
    <ChatInput @ref="chatInput" OnSend="SendAsync" OnStop="Stop" IsBusy="IsBusy" Disabled="@(chatClient is null || loadingHistory)" />
</footer>

@code {
    // A URL identifica a conversa: /?agent=assistant&c=<threadId>
    // => cada aba/usuário tem a sua; recarregar a página (F5) mantém a conversa, que vem do banco.
    [SupplyParameterFromQuery(Name = "agent")] public string? AgentQuery { get; set; }
    [SupplyParameterFromQuery(Name = "c")] public string? ConversationQuery { get; set; }

    private static readonly Regex ValidThreadId = new("^[A-Za-z0-9_-]{8,100}$", RegexOptions.Compiled);

    private readonly List<ChatMessage> messages = [];
    private readonly List<string> toolCalls = [];
    private IReadOnlyList<AgentInfo> agents = [];
    private string? selectedAgentId;
    private string? threadId;
    private string? lastRunId;
    private IChatClient? chatClient;
    private ChatMessage? inProgress;
    private CancellationTokenSource? responseCancellation;
    private bool loadingHistory;
    private string? error;
    private ChatInput? chatInput;
    private ElementReference messageListElement;
    private IJSObjectReference? jsModule;

    private bool IsBusy => inProgress is not null;
    private AgentInfo? SelectedAgent => agents.FirstOrDefault(a => a.Id == selectedAgentId);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            agents = await Api.GetAgentsAsync();
        }
        catch (Exception ex)
        {
            error = $"Não foi possível conectar ao backend: {ex.Message}";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (agents.Count == 0)
        {
            return;
        }

        var agentId = agents.Any(a => a.Id == AgentQuery)
            ? AgentQuery!
            : (agents.FirstOrDefault(a => a.IsDefault) ?? agents[0]).Id;

        // URL sem conversa (ou inválida): gera um threadId novo e reescreve a URL.
        if (ConversationQuery is null || !ValidThreadId.IsMatch(ConversationQuery) || agentId != AgentQuery)
        {
            var conversation = ConversationQuery is not null && ValidThreadId.IsMatch(ConversationQuery) ? ConversationQuery : NewThreadId();
            Nav.NavigateTo(BuildUrl(agentId, conversation), replace: true);
            return;
        }

        if (agentId == selectedAgentId && ConversationQuery == threadId)
        {
            return; // nada mudou
        }

        await OpenConversationAsync(agentId, ConversationQuery);
    }

    private async Task OpenConversationAsync(string agentId, string conversationThreadId)
    {
        Stop();
        messages.Clear();
        toolCalls.Clear();
        error = null;
        lastRunId = null;

        if (agentId != selectedAgentId)
        {
            chatClient?.Dispose();
            chatClient = Api.CreateChatClient(agentId);
            selectedAgentId = agentId;
        }
        threadId = conversationThreadId;

        loadingHistory = true;
        try
        {
            foreach (var stored in await Api.GetMessagesAsync(agentId, conversationThreadId))
            {
                var role = stored.Author == "User" ? ChatRole.User : ChatRole.Assistant;
                messages.Add(new ChatMessage(role, stored.Text));
            }
        }
        catch (Exception ex)
        {
            error = $"Não foi possível carregar o histórico: {ex.Message}";
        }
        finally
        {
            loadingHistory = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Chat/Chat.razor.js");
        }

        if (jsModule is not null)
        {
            await jsModule.InvokeVoidAsync("scrollToBottom", messageListElement);
        }
    }

    private async Task SendAsync(string text)
    {
        if (chatClient is null || threadId is null || IsBusy)
        {
            return;
        }

        error = null;
        toolCalls.Clear();
        var userMessage = new ChatMessage(ChatRole.User, text);
        messages.Add(userMessage);

        var responseText = new TextContent(string.Empty);
        inProgress = new ChatMessage(ChatRole.Assistant, [responseText]);
        responseCancellation = new CancellationTokenSource();
        StateHasChanged();

        // O histórico fica no servidor (SQLite). Enviamos só a nova mensagem + o threadId da conversa
        // (e o runId anterior, como manda o protocolo AG-UI para continuação).
        var currentThreadId = threadId;
        var parentRunId = lastRunId;
        var options = new ChatOptions
        {
            RawRepresentationFactory = _ => new RunAgentInput
            {
                ThreadId = currentThreadId,
                ParentRunId = parentRunId,
            },
        };

        try
        {
            await foreach (var update in chatClient.GetStreamingResponseAsync([userMessage], options, responseCancellation.Token))
            {
                if (update.RawRepresentation is RunStartedEvent runStarted)
                {
                    lastRunId = runStarted.RunId;
                }

                foreach (var content in update.Contents)
                {
                    if (content is FunctionCallContent call && !toolCalls.Contains(call.Name))
                    {
                        toolCalls.Add(call.Name);
                    }
                    else if (content is ErrorContent err)
                    {
                        error = err.Message;
                    }
                }

                responseText.Text += update.Text;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // Usuário clicou em "Parar": mantemos o que já foi gerado.
        }
        catch (Exception ex)
        {
            error = $"Erro ao obter resposta: {ex.Message}";
        }
        finally
        {
            if (!string.IsNullOrWhiteSpace(responseText.Text))
            {
                messages.Add(new ChatMessage(ChatRole.Assistant, responseText.Text));
            }

            inProgress = null;
            responseCancellation?.Dispose();
            responseCancellation = null;
            StateHasChanged();
        }

        if (chatInput is not null)
        {
            await chatInput.FocusAsync();
        }
    }

    private void Stop() => responseCancellation?.Cancel();

    // Nova conversa = novo threadId na URL. A anterior continua salva no banco.
    private void NewConversation() => Nav.NavigateTo(BuildUrl(selectedAgentId ?? agents[0].Id, NewThreadId()));

    private void OnAgentChanged(ChangeEventArgs e)
    {
        if (e.Value?.ToString() is { Length: > 0 } agentId)
        {
            Nav.NavigateTo(BuildUrl(agentId, NewThreadId()));
        }
    }

    private string BuildUrl(string agentId, string conversationThreadId) =>
        Nav.GetUriWithQueryParameters(Nav.BaseUri, new Dictionary<string, object?>
        {
            ["agent"] = agentId,
            ["c"] = conversationThreadId,
        });

    private static string NewThreadId() => Guid.NewGuid().ToString("N");

    public async ValueTask DisposeAsync()
    {
        responseCancellation?.Cancel();
        chatClient?.Dispose();

        if (jsModule is not null)
        {
            try { await jsModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
