{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ChatBot.Api": "Information"
    }
  },
  "AllowedHosts": "*",
  "Channels": {
    "Telegram": {
      "Enabled": false,
      "BotToken": "",
      "Mode": "Polling",
      "WebhookUrl": "",
      "SecretToken": "",
      "DefaultAgent": "",
      "AllowedUserIds": [],
      "MaxConcurrency": 8,
      "DropPendingUpdates": false
    }
  },
  "ConnectionStrings": {
    "ChatBot": "Data Source=chatbot.db"
  },
  "AI": {
    "Provider": {
      "Endpoint": "https://api.openai.com/v1",
      "ApiKey": "",
      "UseEntraId": false
    },
    "DefaultAgent": "assistant",
    "MaxMessagesInContext": 50,
    "Agents": [
      {
        "Id": "assistant",
        "DisplayName": "Assistente (rápido)",
        "Description": "Respostas rápidas para o dia a dia.",
        "Model": "gpt-5-mini",
        "Instructions": "Você é um assistente prestativo e objetivo. Responda em português do Brasil, usando Markdown quando ajudar."
      },
      {
        "Id": "expert",
        "DisplayName": "Especialista (raciocínio)",
        "Description": "Modelo maior para perguntas complexas.",
        "Model": "gpt-5",
        "Instructions": "Você é um especialista técnico. Explique passo a passo, em português do Brasil."
      }
    ]
  }
}
