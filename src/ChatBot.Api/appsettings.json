{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AI": {
    "Provider": {
      "Endpoint": "https://api.openai.com/v1",
      "ApiKey": "",
      "UseEntraId": false
    },
    "DefaultAgent": "assistant",
    "Agents": [
      {
        "Id": "assistant",
        "DisplayName": "Assistente (rápido)",
        "Description": "Respostas rápidas para o dia a dia.",
        "Model": "gpt-5-mini",
        "Instructions": "Você é um assistente prestativo e objetivo. Responda em português do Brasil, usando Markdown quando ajudar."
      },
      {
        "Id": "expert",
        "DisplayName": "Especialista (raciocínio)",
        "Description": "Modelo maior para perguntas complexas.",
        "Model": "gpt-5",
        "Instructions": "Você é um especialista técnico. Explique passo a passo, em português do Brasil."
      }
    ]
  }
}
